# Maintainer: Diagrammo LLC <hello@diagrammo.app>
#
# This recipe has two consumers and has to stay correct for both:
#
#   1. `makepkg -si` from a clone of github.com/diagrammo/dgmo. That is the route
#      a Linux user can take today with nothing hosted anywhere by us — no AUR
#      entry, no repository, no signing key. Arch ships `base-devel`, so
#      `makepkg` is already present on a stock install.
#
#   2. Omarchy's package repository (omacom/omarchy-pkgs), where this would live
#      at `pkgbuilds/dgmo/PKGBUILD` with `.omarchy/package.json` beside it. That
#      metadata file's `npm` upstream watch tracks @diagrammo/dgmo-cli releases,
#      so Omarchy's own pipeline performs the version bumps and nothing of ours
#      has to. Modelled on their `github-copilot-cli` recipe, which is the same
#      shape: an npm-published Node CLI with a prebuilt native addon.
#
# 🔴 Omarchy stopped syncing packages from the AUR on 2026-09-15
# (omacom/omarchy-pkgs#445), so an AUR-only package reaches no Omarchy machine
# by default. Do not "restore" an AUR route on the assumption it feeds theirs.

_npmmodule=@diagrammo/dgmo-cli

pkgname=dgmo
pkgver=0.86.0
# 🔴 pkgrel 2 for an unchanged recipe, deliberately. The channel published
# 0.86.0-1 twice with DIFFERENT bytes — `package()` resolves its dependencies
# from npm at build time, so no two builds match — and a pacman client holding
# the first copy in /var/cache/pacman/pkg then refuses the second with
# "invalid or corrupted package (checksum)". Reported from a real Omarchy
# machine, 2026-09-17. Bumping pkgrel changes the filename, so every cache
# misses cleanly and the upgrade just works. arch-repo.yml now refuses to
# rebuild a filename it already serves, which stops this recurring; this bump
# is what repairs the machines that already have the ambiguous copy.
pkgrel=2
pkgdesc="Render DGMO diagrams to PNG or SVG from the terminal, and wire the DGMO MCP server into AI editors"
arch=('x86_64' 'aarch64')
url="https://github.com/diagrammo/dgmo"
license=('MIT')

# nodejs runs it. glibc and gcc-libs are what the @resvg/resvg-js prebuilt addon
# links against. jsdom and @diagrammo/dgmo-mcp are ordinary npm dependencies and
# come down with the package in package() below — the MCP server in particular is
# NOT a separate install, because `dgmo mcp` resolves it by absolute path
# (`bundledMcpEntry()` in src/cli.ts) and never from PATH.
depends=('nodejs' 'glibc' 'gcc-libs')
makedepends=('npm')

# The prebuilt .node addon must not be stripped. There is no debug package worth
# emitting for a tree that is JavaScript plus one vendor binary.
options=('!strip' '!debug' 'emptydirs')

source=("https://registry.npmjs.org/${_npmmodule}/-/dgmo-cli-${pkgver}.tgz")
noextract=("dgmo-cli-${pkgver}.tgz")
sha256sums=('26ed8618f2b2074cbecc0227340080bd774ba98a74fbb9af204ad457d5f647a1')

package() {
  # 🔴 The published tarball is the CLI bundle ONLY — 30 files, no node_modules —
  # so this step resolves @diagrammo/dgmo-mcp, jsdom and @resvg/resvg-js from the
  # registry over the network. The sha256 above therefore pins what we publish and
  # not the whole dependency tree. That is the same trade the Homebrew formula has
  # always made; it is called out here because it is invisible from the recipe and
  # a reviewer is entitled to know. Making the npm package bundle its dependencies
  # would remove it, and would be a change to how we publish rather than to this.
  npm install -s -g \
    --cache "${srcdir}/npm-cache" \
    --prefix "${pkgdir}/usr" \
    "${srcdir}/dgmo-cli-${pkgver}.tgz"

  # @resvg/resvg-js ships one prebuilt addon per platform as an optional
  # dependency guarded by os/cpu/libc, so npm should install only the matching
  # one. Prune defensively anyway: a foreign .node is dead weight the package
  # would carry forever, and a musl build landing on a glibc distribution is a
  # silently wrong runtime rather than a loud failure.
  local _arch
  case "$CARCH" in
    x86_64)  _arch="x64" ;;
    aarch64) _arch="arm64" ;;
    *)       echo "Unsupported architecture: $CARCH" >&2; exit 1 ;;
  esac
  find "${pkgdir}/usr/lib/node_modules" -depth -type d -name 'resvg-js-*' \
    ! -name "resvg-js-linux-${_arch}-gnu" -exec rm -rf {} +

  # npm records its build directory in every package.json it writes; that path is
  # inside $pkgdir and means nothing on the installed system.
  find "${pkgdir}" -name package.json -print0 | xargs -r -0 sed -i '/_where/d'

  find "${pkgdir}/usr" -type d -exec chmod 755 {} +
  chown -R root:root "${pkgdir}"

  install -dm755 "${pkgdir}/usr/share/licenses/${pkgname}"
  ln -sf "/usr/lib/node_modules/${_npmmodule}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

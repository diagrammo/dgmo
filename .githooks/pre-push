#!/bin/sh
# The checks .github/workflows/ci.yml runs, in the same order, so a push and a
# CI run ask the same questions. Until 2026-08-25 this was one line —
# `pnpm typecheck && pnpm lint && pnpm test && pnpm build`, four of CI's
# thirteen steps — and the nine it skipped could only report themselves as a
# failure email. Spelling was one of them, and sat red for six consecutive
# pushes over a word the dictionary had never been told about (#487).
#
# 🔴 NOT `pnpm check:all`. That is the release gate and differs both ways: it
# adds pnpm audit / publint / attw, which ci.yml excludes by name as flaky
# here, and it omits lint, test, the legacy-alias lint, the bundle-size guard
# and the gallery snapshot.
#
# Cheap first, so a 2-second spelling slip fails in 2 seconds rather than
# behind 89 seconds of tests. Measured warm 2026-08-25: ~113s total, of which
# the four original checks are 89s and everything added here is 24s.

# 🔴 git EXPORTS GIT_DIR (and friends) into every hook, and anything this hook
# runs inherits them. tests/no-nul-bytes.test.ts shells out to
# `git rev-parse --show-toplevel`, which with GIT_DIR set answers with the CWD
# rather than the repo root — so under a hook run in a worktree it reads the
# wrong files and fails. That is doubly load-bearing now that the gate IS a
# worktree: `git worktree add` below would otherwise resolve against the
# inherited GIT_DIR rather than this repo.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

set -e

ZERO=0000000000000000000000000000000000000000
REPO_ROOT=$(git rev-parse --show-toplevel)
# The parent of the checkout, which is ~/code/diagrammo whether this hook runs
# in the main dgmo repo or in a worktree sibling of it.
WORKSPACE=$(dirname "$REPO_ROOT")

# 🔴 Gate in a cleared environment (diagrammo#1592): an exported override such as
# DGMO_ALLOW_SHARED_LINK=1 once reached this gate and failed a test that asserts
# the guard refuses. Re-exec under the workspace allowlist; stdin carries over.
GATE_ENV="$WORKSPACE/scripts/gate-env.sh"
if [ -r "$GATE_ENV" ]; then . "$GATE_ENV"; gate_env_exec "$0" "$@"; fi

# Git hands a pre-push hook "<local ref> <local sha> <remote ref> <remote sha>"
# per ref on stdin. It can only be read once, so capture it up front.
refs=$(cat)

# 🔴 A push can lose the race for main while it waits for the gate lock, and
# used to find out only AFTER the gate — four refusals in five attempts on one
# change, 8 to 20 minutes of queue each (#680). So the remote is asked where the
# ref is, before queueing and again right after the lock is taken, and a push
# that has already lost is refused in seconds with the fix. It never retries on
# its own and never blocks on a remote it cannot reach —
# .githooks/stale-ref-check.sh says why.
REMOTE=${1:-origin}
STALE_REF_CHECK="$REPO_ROOT/.githooks/stale-ref-check.sh"
stale_ref_check() {
  [ -f "$STALE_REF_CHECK" ] || return 0
  printf '%s\n' "$refs" | bash "$STALE_REF_CHECK" "$REMOTE" "$1"
}

pushed=$(printf '%s\n' "$refs" | while read -r _lref lsha _rref _rsha; do
  [ -z "$lsha" ] && continue
  [ "$lsha" = "$ZERO" ] && continue              # branch deletion
  echo "$lsha"
done)

if [ -z "$pushed" ]; then
  # Every ref in this push carries the all-zero sha, so there is no commit to
  # check out and gate. A branch deletion is the usual cause; a push git
  # refused locally as non-fast-forward reaches here too, which is why this no
  # longer claims to know which (#623).
  echo "pre-push: nothing to gate (no commits in this push)"
  exit 0
fi

# 🔴 Gate the pushed COMMIT, never the working tree.
#
# Ten sessions share this checkout, so it is routinely mid-edit by somebody
# else. This hook ran in place until 2026-08-29 and its own header carried a
# ⚠️ saying so, pointing at #445 — the same defect, fixed for the app and the
# cloud gates and left here. Two pushes of a ONE-FILE change (`cspell.json`,
# 18 insertions) were refused within the hour on 2026-08-29, each by a
# different unrelated step:
#
#   * check:spelling — `librsvg` and `Inkscape`, unknown words in another
#     session's uncommitted src/utils/export-container.ts
#   * check:api      — `titleFontWeight: number` narrowed to `400 | 700` by
#     that session's uncommitted src/utils/title-constants.ts
#
# Neither was in the commit. The dirty set went from 52 files to 185 while
# that was happening, so waiting for a quiet moment is unbounded and the
# obvious escape is `--no-verify`, which disarms all seventeen checks at once.
# #534.
#
# 🔴 There is deliberately NO in-place fast path, not even for a clean tree at
# the pushed sha. The app's gate had one and #499 removed it: "clean tree" is
# not "tree equals the pushed commit" when dist/ is shared, and the tidier your
# tree was, the less isolation your push got — which is the wrong way round.
#
# 🔴 The gate MUST be a direct child of ~/code/diagrammo, exactly as the app's
# is, and for a reason that is easy to miss here: dgmo has no relative package
# symlinks, but its TESTS reach a sibling repo. `tests/map-layout-golden.ts`
# resolves `../../dgmo-content/examples/map` and asserts a floor of 16 fixtures
# — 15 come from gallery/, 3 from that sibling. A gate in TMPDIR sees only the
# 15 and fails the floor, which reads as a missing fixture rather than as a
# misplaced worktree. Measured 2026-08-29, on the first run of this hook.
#
# `.gate-dgmo.*` rather than `dgmo-wt-*`: the latter is gitignored by the
# workspace, which is what made cspell read an empty checkout in a hand-made
# worktree (#530). `/.gate-dgmo.*/` is ignored there too, beside the app's.
gate=

# 🔴 One gate at a time, across every repo in the workspace (#557). These
# gates each take minutes at full CPU, and ten sessions share this laptop:
# run several at once and they slow each other down past the point where the
# suite is reliable, so a push fails on tests unrelated to its change and the
# retry adds more load. Measured 2026-08-29 — load 19.8 on 10 cores, twelve
# abandoned gate worktrees, eleven commits nobody could land.
#
# The lock never refuses a push: a missing script, an unreadable holder or a
# wait past its ceiling all proceed unlocked and say so.
GATE_LOCK="$WORKSPACE/scripts/gate-lock.sh"

# #1655: a nightly-verify.sh pass at this same TREE left a receipt of every command it ran.
# run_checks accepts those steps instead of running them a second time; everything the verify
# did not run still runs. Without the script every step runs, as before. The receipt is keyed
# by tree and checked for age, a clean tree and linked siblings — see gate-receipt.sh.
GATE_RECEIPT="$WORKSPACE/scripts/gate-receipt.sh"
if [ -r "$GATE_RECEIPT" ]; then . "$GATE_RECEIPT"
else receipt_load() { :; }; receipt_covers() { return 1; }; receipt_run() { "$@"; }; fi

cleanup() {
  # The exit status and the worktree go to the gate ledger (#1588): with no
  # status a failed gate would record as unknown, and with no worktree, no sha.
  gate_rc=$?
  if [ -x "$GATE_LOCK" ]; then "$GATE_LOCK" release $$ "$gate_rc" "$gate" || true; fi
  [ -n "$gate" ] || return 0
  git worktree remove --force "$gate" >/dev/null 2>&1 || true
  git worktree prune >/dev/null 2>&1 || true
  rm -rf "$gate"
  gate=
}
trap cleanup EXIT INT TERM

# A gate that died without running its trap leaves a registered worktree behind
# — one was found on 2026-08-29, from the APP's hook, which makes a dgmo gate of
# its own.
#
# 🔴 The `git worktree prune` that used to stand here could not collect them,
# and eleven accumulated under it holding 6.1 GB. Prune drops registrations
# whose directory is already GONE; a leaked gate still has its directory, so
# prune inspects it, calls it valid and moves on. The sweep deletes the
# directory first — which is what makes the prune inside it work.
GATE_SWEEP="$WORKSPACE/scripts/gate-sweep.sh"
if [ -x "$GATE_SWEEP" ]; then "$GATE_SWEEP" || true; fi

run_checks() {
  # Every step goes through receipt_run (#1655): a step the verify passed at this tree
  # prints one line and is not run again; any other runs exactly as written.
  echo "→ installed dependency tree"
  receipt_run pnpm check:install-lock

  echo "→ formatting"
  receipt_run pnpm format:check

  echo "→ hygiene"
  receipt_run pnpm check:deadcode
  receipt_run pnpm check:duplication
  receipt_run pnpm check:deps

  echo "→ spelling"
  receipt_run pnpm check:spelling

  echo "→ circular dependencies"
  receipt_run pnpm check:circular

  echo "→ dependency ranges"
  receipt_run pnpm check:dep-ranges

  echo "→ legacy alias syntaxes"
  receipt_run bash scripts/lint-no-legacy-alias.sh

  echo "→ typecheck"
  receipt_run pnpm typecheck

  echo "→ lint"
  receipt_run pnpm lint

  echo "→ test"
  receipt_run pnpm test

  # The three after the build need dist/, which only the build produces, so the
  # build is skipped only when all three are covered too. They are called as
  # scripts rather than via `pnpm check:size` / `check:api` / `gallery:snapshot`,
  # each of which would run a second build; the verify's check-all runs the
  # snapshot as `pnpm gallery:snapshot` (#1618), which is why that step accepts
  # either spelling.
  echo "→ build"
  if receipt_covers pnpm build && receipt_covers node scripts/check-bundle-size.cjs \
     && receipt_covers node --test scripts/check-api.test.mjs && receipt_covers bash scripts/check-api.sh check \
     && { receipt_covers node scripts/gallery-snapshot.mjs || receipt_covers pnpm gallery:snapshot; }; then
    echo "pre-push: pnpm build — passed in the verify at this tree, and so did every step that reads dist/; not re-run (receipt)"
  else
    pnpm build
  fi

  echo "→ bundle size"
  receipt_run node scripts/check-bundle-size.cjs

  echo "→ public API surface"
  receipt_run node --test scripts/check-api.test.mjs
  receipt_run bash scripts/check-api.sh check

  echo "→ gallery snapshot"
  if receipt_covers pnpm gallery:snapshot; then
    echo "pre-push: node scripts/gallery-snapshot.mjs — passed in the verify at this tree as pnpm gallery:snapshot, not re-run (receipt)"
  else
    receipt_run node scripts/gallery-snapshot.mjs
  fi
}

run_gate() {
  sha=$1
  short=$(git rev-parse --short "$sha")

  echo "pre-push: gating a worktree at $short"
  # `git worktree add` accepts an existing empty directory, so mktemp's own
  # directory is the worktree rather than its parent.
  gate=$(mktemp -d "$WORKSPACE/.gate-dgmo.XXXXXX")
  git worktree add --detach --quiet "$gate" "$sha"
  # Who to blame for this directory if it outlives the push.
  echo $$ > "$gate/.gate-owner"

  # 🔴 A REAL install, never a symlink to the working checkout's node_modules.
  # Borrowing is free and is what the app's gate tried first: `pnpm install`
  # walks the borrowed tree and rewrites the SHARED checkout's node_modules to
  # point into a directory the gate is about to delete — 52 dangling links on
  # 2026-08-26, which tore dist/ and stopped the app booting. Read-only in
  # intent, read-write in fact.
  #
  # ~5s against a warm pnpm store (measured 2026-08-29) on a ~113s gate.
  # check:install-lock compares the committed lockfile against pnpm's own
  # record, so the install has to be frozen for the first step to pass.
  (cd "$gate" && pnpm install --frozen-lockfile --prefer-offline --reporter=silent)

  receipt_load "$gate" "$sha"
  (cd "$gate" && run_checks)
  cleanup
}

# The lock is where the ref goes stale, so the check runs on both sides of it:
# once before queueing, and once right after it is taken — that second one is
# the one that matters. Refusing after the lock exits through the cleanup trap,
# which releases it.
stale_ref_check before-lock || exit 1
if [ -x "$GATE_LOCK" ]; then "$GATE_LOCK" acquire dgmo $$ || true; fi
stale_ref_check after-lock || exit 1

for sha in $pushed; do
  run_gate "$sha"
done

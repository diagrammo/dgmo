@top Document { (newline | Comment | ContentLine)* }

ContentLine { contentPart+ newline }

contentPart {
  SyncArrow | AsyncArrow |
  Duration | DateLiteral | Percentage | Number |
  SectionMarker |
  Url |
  OpenBracket | CloseBracket | OpenParen | CloseParen | OpenAngle | CloseAngle |
  Pipe | Colon | Comma | Plus | Dash | Tilde | Star | Question |
  ChartType |
  TagKeyword | DirectiveKeyword | ControlKeyword | ModifierKeyword |
  QuotedString | Identifier |
  Punct
}

@skip { spaces }

@tokens {
  spaces { $[ \t]+ }
  newline { "\n" }

  Comment { "//" ![\n]* }

  SyncArrow { "->" }
  AsyncArrow { "~>" }

  Duration { $[0-9]+ ("." $[0-9]+)? ("min" | "bd" | "h" | "d" | "w" | "m" | "q" | "y" | "s") "?"? }
  // ISO `YYYY-MM[-DD]` plus the § BL-121 liberal numeric slash/dash forms
  // `M/D[/YY[YY]]` and `M-D[-YY[YY]]` (month-name dates highlight as
  // words/Identifiers). The ISO arm keeps 4-digit-year dates whole via
  // longest-match; the short dash arm covers bare `MM-DD`/`M-D` and US
  // `MM-DD-YYYY` — without it `07-11` split into Number-Dash-Number.
  DateLiteral {
    $[0-9] $[0-9] $[0-9] $[0-9] "-" $[0-9] $[0-9] ("-" $[0-9] $[0-9])? |
    $[0-9] $[0-9]? "/" $[0-9] $[0-9]? ("/" $[0-9] $[0-9] ($[0-9] $[0-9])?)? |
    $[0-9] $[0-9]? "-" $[0-9] $[0-9]? ("-" $[0-9] $[0-9] ($[0-9] $[0-9])?)?
  }
  Percentage { $[0-9]+ ("." $[0-9]+)? "%" }
  Number {
    $[0-9] $[0-9]? $[0-9]? ("," $[0-9] $[0-9] $[0-9])+ ("." $[0-9]+)? |
    $[0-9]+ ("_" $[0-9]+)+ ("." $[0-9]+)? |
    $[0-9]+ ("." $[0-9]+)?
  }

  SectionMarker { "==" }
  Url { "http" "s"? "://" ![ \t\n|,)\]>]+ }

  Pipe { "|" }
  Colon { ":" }
  Comma { "," }
  Plus { "+" }
  Dash { "-" }
  Tilde { "~" }
  Star { "*" }
  Question { "?" }
  OpenBracket { "[" }
  CloseBracket { "]" }
  OpenParen { "(" }
  CloseParen { ")" }
  OpenAngle { "<" }
  CloseAngle { ">" }

  Identifier { $[a-zA-Z_] ($[a-zA-Z0-9_./&?=@#!'+] | "-" $[a-zA-Z_./&?=@#!'+])* }

  // Universal Name Handling: quoted form for names containing reserved
  // chars (pipe, colon, edge sigils, brackets) or wanting a single
  // multi-word token for syntax highlighting. No `"`-inside-`"` escape.
  QuotedString { '"' ![\n"]* '"' }

  Punct { ![$[ \t\n] }

  @precedence {
    Comment, SyncArrow, AsyncArrow,
    Duration, DateLiteral, Percentage, Number, SectionMarker, Url,
    Pipe, Colon, Comma, Plus, Dash, Tilde, Star, Question,
    OpenBracket, CloseBracket, OpenParen, CloseParen, OpenAngle, CloseAngle,
    QuotedString, Identifier, Punct
  }
}

@external specialize {Identifier} specializeKeyword from "./tokens" {
  ChartType, TagKeyword, DirectiveKeyword, ControlKeyword, ModifierKeyword
}

// Was knip.json until 2026-08-07. Renamed to .jsonc purely so the ignore
// entries can carry the reason they exist — an unexplained ignore is the kind
// a later session deletes, re-breaks CI with, and then re-adds.
{
  "ignoreDependencies": [
    // 🔴 Used by `.githooks/pre-commit`, which knip cannot see.
    //
    // knip's husky plugin reads `.husky/*` and counts what those scripts run.
    // The hooks moved to a TRACKED `.githooks/` on 2026-09-01 so that a push
    // from a worktree is gated at all (#623) — `core.hooksPath` is shared by
    // every worktree and `.husky/_` is written by `pnpm install`, so a fresh
    // worktree aimed git at a directory that did not exist and git skipped the
    // hook in silence. knip has no equivalent plugin for a plain hooks
    // directory, so this is now invisible to it. It is not dead: delete it and
    // every commit stops being linted.
    "lint-staged",

    // Declared as optional peerDependencies, imported by src/editor/*.
    "@lezer/common",
    "@lezer/highlight",
    "@lezer/lr",
    "axe-core",
    "type-coverage",

    // 🔴 This repo publishes TWO packages, and knip only sees one manifest.
    //
    // `src/cli.ts` is the source of `@diagrammo/dgmo-cli`, which declares
    // `@diagrammo/dgmo-mcp` as an ordinary dependency in `cli/package.json`.
    // The file sits in the root `src/` tree (tsup builds it out to
    // `cli/dist/cli.cjs`), so knip reads it against the ROOT manifest, where
    // the dependency correctly does not appear — the library must never
    // depend on the MCP server.
    //
    // There is no cleaner expression of this: knip's `workspaces` maps a
    // directory to a manifest, and this entry point is not in `cli/`.
    // Do not "fix" this by adding the package to the root dependencies.
    "@diagrammo/dgmo-mcp",

    // The candidate browser stand-in under evaluation, imported by
    // scripts/dom-shim-diff.mjs and deliberately by nothing else — the whole
    // point of that measurement is that the swap needs no source change to
    // try. It is a devDependency of an experiment, not dead weight; when the
    // jsdom-or-linkedom question is decided it either becomes a real
    // dependency or leaves with the script.
    "linkedom",
  ],
  "ignoreBinaries": ["du", "vite"],
  "ignore": [
    "src/editor/tokens.ts",
    // The `prepack` gate for @diagrammo/dgmo-cli — it renders one gallery
    // fixture per chart type and aborts the pack if any fails. Referenced from
    // `cli/package.json`, which knip reads against the ROOT manifest for the
    // same reason as `@diagrammo/dgmo-mcp` above: the entry point lives in
    // `scripts/`, not in `cli/`, so `workspaces` cannot map it. Deleting this
    // file would let a CLI that cannot draw reach npm — it has once.
    "scripts/prepack-cli.mjs",
    // Same shape for the third package: `standalone/package.json`'s prepack.
    // This repo now publishes three manifests and knip reads one, so any
    // entry point belonging to `cli/` or `standalone/` lands here.
    "scripts/prepack-standalone.mjs",
    // The acceptance test for replacing jsdom with linkedom as the browser
    // stand-in (#123): it renders every gallery fixture under each and diffs
    // the SVGs byte for byte. Nothing imports it and nothing should — the
    // suite runs in jsdom by configuration, so it would stay green whichever
    // one ships, which is precisely why this exists outside it. It arrived on
    // main 2026-08-17 and had CI red at the hygiene step within the hour.
    "scripts/dom-shim-diff.mjs",
    "scripts/audit-solid-fill-contrast.ts",
    "scripts/generate-examples-gallery.mjs",
    "scripts/check-bundle-size.cjs",
    "scripts/migrate-as-aliases.mjs",
    "scripts/migrate-as-aliases.test.mjs",
    "scripts/build-airports-snapshot.mjs",
    "scripts/gen-ai-core.mjs",
    "scripts/eval-ai-generation.mjs",
    "scripts/eval-tools.mjs",
    "scripts/gen-body-surface.mjs",
    "scripts/enrich-gazetteer-tz.mjs",
    "api-baseline/**",
    "tools/**",
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off",
    "exports": "warn",
    "types": "warn",
  },
}

node_modules/
dist/
coverage/
*.tsbuildinfo
.DS_Store
gallery/output/
gallery/snapshots/*.fresh.svg
src/editor/dgmo.grammar.js
src/editor/dgmo.grammar.terms.js

# Dev-reload sentinel (touched by tsup --watch; watched by diagrammo-app Vite)
.vite-reload

# guidance-studio write-back transient backup
docs/language-reference.md.bak
docs/language-reference.md.tmp-*

# scratch CLI renders at repo root (19 were committed by accident)
/*.png

# @diagrammo/dgmo-cli build output — regenerate with `pnpm build`.
# Only cli/package.json is checked in.
cli/*
!cli/package.json
!cli/README.md

# @diagrammo/dgmo-standalone build output — the two <script src> drop-ins,
# regenerate with `pnpm build`. Only standalone/package.json is checked in.
standalone/*
!standalone/package.json
!standalone/README.md

# Generated from vendor/inter by scripts/build-fonts.mjs (pnpm fonts, run by prebuild).
# The tracked source of truth is vendor/inter/ — never edit these by hand.
fonts/

# Arch packaging build artifacts. `diagrammo.gpg` is deliberately NOT committed:
# it is the public half of the channel's signing key, exported by
# arch-repo.yml at build time and fetched by hand for a local `makepkg`.
packaging/arch/**/*.pkg.tar.zst
packaging/arch/**/*.pkg.tar.zst.sig
packaging/arch/keyring/diagrammo.gpg
packaging/arch/src/
packaging/arch/pkg/
packaging/arch/keyring/src/
packaging/arch/keyring/pkg/

{
  "name": "@diagrammo/dgmo-cli",
  "version": "0.72.0",
  "description": "Render DGMO diagrams to PNG or SVG from the terminal, and wire the DGMO MCP server into AI editors.",
  "keywords": [
    "diagram",
    "cli",
    "dgmo",
    "diagrammo",
    "svg",
    "png",
    "mcp"
  ],
  "license": "MIT",
  "author": "Diagrammo LLC",
  "homepage": "https://diagrammo.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diagrammo/dgmo.git",
    "directory": "cli"
  },
  "bugs": "https://github.com/diagrammo/dgmo/issues",
  "type": "commonjs",
  "bin": {
    "dgmo": "dist/cli.cjs"
  },
  "files": [
    "dist",
    "fonts",
    ".claude/commands",
    ".github/copilot-instructions.md",
    ".cursorrules",
    ".windsurfrules",
    "SKILL.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@diagrammo/dgmo-mcp": ">=0.20.1 <1",
    "@resvg/resvg-js": "^2.6.2",
    "jsdom": "^29.1.1"
  },
  "scripts": {
    "prepack": "node ../scripts/prepack-cli.mjs",
    "postinstall": "node -e \"console.log('\\n💡 Claude Code user? Run: dgmo install claude-code\\n')\""
  },
  "publishConfig": {
    "access": "public"
  }
}

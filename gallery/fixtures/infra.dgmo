chart: infra
title: Production Traffic Flow
direction: LR

tag: Team alias t
  Backend(blue)
  Platform(teal)

edge
  rps: 10000
  -> CloudFront

CloudFront | t: Platform
  description: CDN — edge cache for assets and API responses
  cache-hit: 80%
  -> CloudArmor

CloudArmor | t: Platform
  description: WAF — blocks bots and malicious traffic
  firewall-block: 5%
  -> ALB

ALB | t: Platform
  -/api-> [API Pods] | split: 60%
  -/purchase-> [Commerce Pods] | split: 30%
  -/static-> StaticServer | split: 10%

[API Pods]
  APIServer | t: Backend
    description: Core REST API — auth, orders, user profiles
    instances: 3
    max-rps: 500
    latency-ms: 45
    cb-error-threshold: 50%

[Commerce Pods]
  PurchaseMS
    description: Checkout and payment processing
    instances: 1-8
    max-rps: 300
    latency-ms: 120

StaticServer | t: Platform
  description: Serves static assets (JS, CSS, images)
  latency-ms: 5

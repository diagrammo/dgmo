flowchart Decision Flow

(Start) -> /Get Input/ -> <Valid?>
  -yes-> [Process Data] -> (Done)
  -no-> [Show Error] -> /Get Input/

// A brand theme: square corners and hairline strokes (#1836).
palette Press
  radius 0
  stroke-weight 1
  light
    bg #fff1e5
    surface #f2dfce
    overlay #f7e8db
    border #ccc1b7
    text #33302e
    text-muted #66605c
    text-on-fill-light #fff1e5
    text-on-fill-dark #33302e
    primary #0f5499
    secondary #990f3d
    accent #0d7680
    destructive #cc0000
    colors
      red #990f3d
      orange #d9661a
      yellow #a87d00
      green #00994d
      blue #0f5499
      purple #593380
      teal #0d7680
      cyan #2a87c8
      gray #8a8179
      black #33302e
      white #f2dfce

swimlane Insurance Claim
direction LR

tag Risk as r
  low green
  high red

[Submit]
  lane Customer gray
    Submit Claim -> <Validate>
[Triage]
  lane Customer gray
    (!Rejected)
  lane Claims Agent blue
    <Validate>
      -invalid-> (!Rejected)
      -valid-> <+ Fork>
    <+ Fork>
      -> Fraud Check
      -> Assign Adjuster
[Assess]
  lane Customer gray
    (!Denied)
  lane Claims Agent blue
    Fraud Check r: high -> <Approve>
  lane Adjuster purple
    Assign Adjuster -> [[Inspect Property]]
    [[Inspect Property]]
      -retry-> Assign Adjuster
      -> <Approve>
    <Approve>
      -reject-> (!Denied)
      -approve-> Issue Payment
[Settle]
  lane Payments green
    Issue Payment -> (Paid) success

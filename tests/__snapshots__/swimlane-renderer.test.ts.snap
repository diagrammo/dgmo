exports[`swimlane renderer — snapshots > insurance (LR, phases + gateways + terminals) 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1092" height="574" viewBox="0 0 1092 574" preserveAspectRatio="xMidYMin meet" style="font-family: Inter, system-ui, Avenir, Helvetica, Arial, sans-serif;"><defs><marker id="sw-arrow" viewBox="0 0 10 7" refX="10" refY="3.5" markerWidth="10" markerHeight="7" orient="auto"><polygon points="0,0 10,3.5 0,7" fill="#4c566a"></polygon></marker><marker id="sw-arrow-bf616a" viewBox="0 0 10 7" refX="10" refY="3.5" markerWidth="10" markerHeight="7" orient="auto"><polygon points="0,0 10,3.5 0,7" fill="#bf616a"></polygon></marker><marker id="sw-arrow-a3be8c" viewBox="0 0 10 7" refX="10" refY="3.5" markerWidth="10" markerHeight="7" orient="auto"><polygon points="0,0 10,3.5 0,7" fill="#a3be8c"></polygon></marker></defs><g transform="translate(0, 40)"><g class="dgmo-swimlane-lanes"><path d="M10,62 H1042 A10,10 0 0 1 1052,72 V136 A10,10 0 0 1 1042,146 H10 A10,10 0 0 1 0,136 V72 A10,10 0 0 1 10,62 Z" fill="#dee1e8" stroke="#e0e5ed" stroke-width="1" data-line-number="9"></path><path d="M10,62 H116  V146  H10 A10,10 0 0 1 0,136 V72 A10,10 0 0 1 10,62 Z" fill="#d2d7de" opacity="0.6"></path><text x="12" y="104" text-anchor="start" dominant-baseline="middle" font-size="12" font-weight="bold" fill="#3f4757">Customer</text><path d="M10,150 H1042 A10,10 0 0 1 1052,160 V236 A10,10 0 0 1 1042,246 H10 A10,10 0 0 1 0,236 V160 A10,10 0 0 1 10,150 Z" fill="#dfe5ee" stroke="#e0e5ed" stroke-width="1" data-line-number="14"></path><path d="M10,150 H116  V246  H10 A10,10 0 0 1 0,236 V160 A10,10 0 0 1 10,150 Z" fill="#d5dde8" opacity="0.6"></path><text x="12" y="198" text-anchor="start" dominant-baseline="middle" font-size="12" font-weight="bold" fill="#485e7b">Claims Agent</text><path d="M10,250 H1042 A10,10 0 0 1 1052,260 V336 A10,10 0 0 1 1042,346 H10 A10,10 0 0 1 0,336 V260 A10,10 0 0 1 10,250 Z" fill="#e7e6ee" stroke="#e0e5ed" stroke-width="1" data-line-number
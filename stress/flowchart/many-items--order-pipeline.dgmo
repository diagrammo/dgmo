[Intake] -> [Validator 11]
[Intake] -> [Validator 12]
[Validator 1] -> [Enricher 1]
[Validator 2] -> [Enricher 1]
[Validator 3] -> [Enricher 1]
[Validator 4] -> [Enricher 2]
[Validator 5] -> [Enricher 2]
[Validator 6] -> [Enricher 2]
[Validator 7] -> [Enricher 3]
[Validator 8] -> [Enricher 3]
[Validator 9] -> [Enricher 3]
[Validator 10] -> [Enricher 4]
[Validator 11] -> [Enricher 4]
[Validator 12] -> [Enricher 4]
[Enricher 1] -> <Route 1: priority customer?>
<Route 1: priority customer?> -yes-> [Fast Lane 1]
<Route 1: priority customer?> -no-> [Standard Lane 1]
[Fast Lane 1] -> [Fulfilment]
[Standard Lane 1] -> [Fulfilment]
[Enricher 2] -> <Route 2: priority customer?>
<Route 2: priority customer?> -yes-> [Fast Lane 2]
<Route 2: priority customer?> -no-> [Standard Lane 2]
[Fast Lane 2] -> [Fulfilment]
[Standard Lane 2] -> [Fulfilment]
[Enricher 3] -> <Route 3: priority customer?>
<Route 3: priority customer?> -yes-> [Fast Lane 3]
<Route 3: priority customer?> -no-> [Standard Lane 3]
[Fast Lane 3] -> [Fulfilment]
[Standard Lane 3] -> [Fulfilment]
[Enricher 4] -> <Route 4: priority customer?>
<Route 4: priority customer?> -yes-> [Fast Lane 4]
<Route 4: priority customer?> -no-> [Standard Lane 4]
[Fast Lane 4] -> [Fulfilment]

flowchart Order Pipeline With Fan-Out
// stress: many-items — forty-plus nodes in one flowchart, three layers of fan-out and a shared sink
[Intake] -> [Validator 1]
[Intake] -> [Validator 2]
[Intake] -> [Validator 3]
[Intake] -> [Validator 4]
[Intake] -> [Validator 5]
[Intake] -> [Validator 6]

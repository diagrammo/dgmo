{
  "name": "@diagrammo/dgmo",
  "version": "0.77.0",
  "description": "DGMO diagram markup language — parser, renderer, and color system",
  "license": "MIT",
  "author": "Diagrammo LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diagrammo/dgmo.git"
  },
  "homepage": "https://github.com/diagrammo/dgmo#readme",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "default": "./dist/editor.js"
    },
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "default": "./dist/highlight.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "default": "./dist/advanced.js"
    },
    "./chart-meta": {
      "types": "./dist/chart-meta.d.ts",
      "default": "./dist/chart-meta.js"
    },
    "./cloud-reference": {
      "types": "./dist/cloud-reference.d.ts",
      "default": "./dist/cloud-reference.js"
    },
    "./live-link-resolve": {
      "types": "./dist/live-link-resolve.d.ts",
      "default": "./dist/live-link-resolve.js"
    },
    "./completion": {
      "types": "./dist/completion-registry.d.ts",
      "default": "./dist/completion-registry.js"
    },
    "./countdown": {
      "types": "./dist/countdown.d.ts",
      "default": "./dist/countdown.js"
    },
    "./clock": {
      "types": "./dist/clock.d.ts",
      "default": "./dist/clock.js"
    },
    "./pert": {
      "types": "./dist/pert.d.ts",
      "default": "./dist/pert.js"
    },
    "./fonts/*": "./fonts/*",
    "./block": {
      "types": "./dist/block.d.ts",
      "default": "./dist/block.js"
    },
    "./block.css": "./dist/block.css"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/*.css",
    "dist/map-data/*.json",
    "fonts",
    "docs/*.md",
    "gallery/fixtures"
  ],
  "sideEffects": [
    "./src/palettes/*.ts",
    "./dist/palettes/*"
  ],
  "scripts": {
    "codegen": "lezer-generator src/editor/dgmo.grammar -o src/editor/dgmo.grammar.js",
    "fonts": "node scripts/build-fonts.mjs",
    "metrics": "node scripts/build-text-metrics.mjs",
    "prebuild": "rm -rf dist && pnpm codegen && pnpm fonts && pnpm metrics",
    "build": "DGMO_DEV_RELOAD=1 tsup",
    "typecheck": "tsc --noEmit",
    "predev": "pnpm fonts",
    "dev": "DGMO_DEV_RELOAD=1 tsup --watch",
    "pretest": "pnpm codegen && pnpm fonts",
    "test": "TZ=UTC vitest run --coverage",
    "bench:perf": "vitest run --config vitest.perf.config.ts tests/perf-bench.ts",
    "bench:bl": "vitest run --config vitest.bench.config.ts tests/bl-layout-bench.ts",
    "bench:bl-collapse": "vitest run --config vitest.bench.config.ts tests/bl-collapse-bench.ts",
    "bench:bl-options": "vitest run --config vitest.bench.config.ts tests/bl-options.ts",
    "bench:bl-overlap": "vitest run --config vitest.bench.config.ts tests/bl-overlap-debug.ts",
    "bl-gallery": "vitest run --config vitest.bench.config.ts tests/bl-gallery.ts",
    "test:watch": "TZ=UTC vitest",
    "test:auto": "pnpm build && TZ=UTC vitest run tests/auto.test.ts tests/safe-href.test.ts",
    "sri": "node scripts/sri.mjs",
    "eval:tools": "pnpm build && pnpm -C ../dgmo-mcp build:fast && node scripts/eval-tools.mjs",
    "eval:ai": "pnpm build && pnpm -C ../dgmo-mcp build:fast && node scripts/eval-ai-generation.mjs",
    "build:map-data": "node scripts/build-map-data.mjs",
    "gallery": "pnpm build && node scripts/generate-gallery.mjs",
    "gallery:snapshot": "pnpm build && node scripts/gallery-snapshot.mjs",
    "gallery:snapshot:update": "pnpm build && node scripts/gallery-snapshot.mjs --update",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "check:api": "node --test scripts/check-api.test.mjs && pnpm build && bash scripts/check-api.sh check",
    "check:api:update": "pnpm build && bash scripts/check-api.sh update",
    "check:duplication": "jscpd ./src",
    "check:deadcode": "knip",
    "check:spelling": "cspell \"src/**/*.ts\" \"tests/**/*.ts\"",
    "check:all": "pnpm check:install-lock && pnpm check:deadcode && pnpm check:spelling && pnpm check:duplication && pnpm check:circular && pnpm check:deps && pnpm check:dep-ranges && pnpm check:security && node --test scripts/check-api.test.mjs && pnpm build && bash scripts/check-api.sh check && pnpm check:publish && pnpm check:types",
    "check:circular": "node --test scripts/check-circular.test.mjs && madge --circular --extensions ts src/ --json | node scripts/check-circular.mjs",
    "check:deps": "depcheck --ignores='@diagrammo/dgmo,@diagrammo/dgmo-mcp,@codemirror/language,@lezer/*,husky,lint-staged,tsup,axe-core,type-coverage'",
    "check:install-lock": "node --test scripts/check-install-lock.test.mjs && node scripts/check-install-lock.mjs",
    "check:security": "pnpm audit --prod",
    "check:dep-ranges": "node scripts/check-dep-ranges.mjs",
    "check:publish": "publint",
    "check:size": "pnpm build && node scripts/check-bundle-size.cjs",
    "check:size:update": "pnpm build && node scripts/check-bundle-size.cjs --update",
    "check:types": "attw --pack . --ignore-rules no-resolution false-export-default cjs-resolves-to-esm",
    "prepare": "husky"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "d3-array": "^3.2.4",
    "d3-cloud": "^1.2.9",
    "d3-geo": "^3.1.1",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "jsdom": "^29.1.1",
    "lz-string": "^1.5.0",
    "topojson-client": "^3.1.0"
  },
  "pnpm": {
    "overrides": {
      "undici": "^7.29.0"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@codemirror/language": "^6.12.3",
    "@eslint/js": "^10.0.1",
    "@lezer/generator": "^1.8.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/d3-array": "^3.2.2",
    "@types/d3-cloud": "^1.2.9",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.8",
    "@types/jsdom": "^28.0.3",
    "@types/topojson-client": "^3.1.5",
    "@vitest/coverage-v8": "^4.1.8",
    "axe-core": "^4.12.0",
    "cspell": "^10.0.1",
    "depcheck": "^1.4.7",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "eslint-plugin-security": "^4.0.0",
    "fast-check": "^4.8.0",
    "fflate": "^0.8.3",
    "husky": "^9.1.7",
    "jscpd": "^4.2.4",
    "knip": "^6.15.0",
    "linkedom": "^0.18.13",
    "lint-staged": "^17.0.7",
    "madge": "^8.0.0",
    "mapshaper": "0.7.22",
    "prettier": "^3.8.3",
    "publint": "^0.3.21",
    "subset-font": "^2.5.0",
    "tsup": "^8.5.1",
    "type-coverage": "^2.29.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "@codemirror/language": "^6.12.3",
    "@lezer/common": "^1.5.1",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.8"
  },
  "peerDependenciesMeta": {
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@lezer/common": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    },
    "@lezer/lr": {
      "optional": true
    }
  }
}

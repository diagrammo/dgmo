{
  "name": "@diagrammo/dgmo",
  "version": "0.8.17",
  "description": "DGMO diagram markup language — parser, renderer, and color system",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dgmo": "dist/cli.cjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./editor": {
      "import": {
        "types": "./dist/editor.d.ts",
        "default": "./dist/editor.js"
      },
      "require": {
        "types": "./dist/editor.d.cts",
        "default": "./dist/editor.cjs"
      }
    },
    "./highlight": {
      "import": {
        "types": "./dist/highlight.d.ts",
        "default": "./dist/highlight.js"
      },
      "require": {
        "types": "./dist/highlight.d.cts",
        "default": "./dist/highlight.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "gallery/fixtures",
    ".claude/commands",
    ".github/copilot-instructions.md",
    ".cursorrules",
    ".windsurfrules",
    "AGENTS.md"
  ],
  "sideEffects": false,
  "scripts": {
    "prebuild": "rm -rf dist && lezer-generator src/editor/dgmo.grammar -o src/editor/dgmo.grammar.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "gallery": "pnpm build && node scripts/generate-gallery.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "check:duplication": "jscpd ./src",
    "check:deadcode": "knip",
    "check:spelling": "cspell \"src/**/*.ts\" \"tests/**/*.ts\"",
    "check:size": "pnpm build && du -sh dist/ && echo '---' && ls -lh dist/*.js dist/*.cjs",
    "postinstall": "node -e \"console.log('\\n💡 Claude Code user? Run: dgmo --install-claude-skill\\n')\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "d3-array": "^3.2.4",
    "d3-cloud": "^1.2.9",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "echarts": "^6.0.0",
    "jsdom": "^29.0.1",
    "lz-string": "^1.5.0"
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.3",
    "@eslint/js": "^10.0.1",
    "@lezer/generator": "^1.8.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-cloud": "^1.2.9",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.8",
    "@types/jsdom": "^28.0.1",
    "cspell": "^9.7.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "husky": "^9.1.7",
    "jscpd": "^4.0.8",
    "knip": "^6.3.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "@codemirror/language": "^6.12.3",
    "@lezer/common": "^1.5.1",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.8"
  },
  "peerDependenciesMeta": {
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@lezer/common": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    },
    "@lezer/lr": {
      "optional": true
    }
  }
}

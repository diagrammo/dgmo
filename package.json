{
  "name": "@diagrammo/dgmo",
  "version": "0.8.26",
  "description": "DGMO diagram markup language — parser, renderer, and color system",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/diagrammo/dgmo.git"
  },
  "homepage": "https://github.com/diagrammo/dgmo#readme",
  "type": "module",
  "bin": {
    "dgmo": "dist/cli.cjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./editor": {
      "import": {
        "types": "./dist/editor.d.ts",
        "default": "./dist/editor.js"
      },
      "require": {
        "types": "./dist/editor.d.cts",
        "default": "./dist/editor.cjs"
      }
    },
    "./highlight": {
      "import": {
        "types": "./dist/highlight.d.ts",
        "default": "./dist/highlight.js"
      },
      "require": {
        "types": "./dist/highlight.d.cts",
        "default": "./dist/highlight.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      },
      "require": {
        "types": "./dist/internal.d.cts",
        "default": "./dist/internal.cjs"
      }
    },
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "dist",
    "fonts",
    "src",
    "docs",
    "gallery/fixtures",
    ".claude/commands",
    ".github/copilot-instructions.md",
    ".cursorrules",
    ".windsurfrules",
    "AGENTS.md"
  ],
  "sideEffects": false,
  "scripts": {
    "codegen": "lezer-generator src/editor/dgmo.grammar -o src/editor/dgmo.grammar.js",
    "prebuild": "rm -rf dist && pnpm codegen",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "pretest": "pnpm codegen",
    "test": "vitest run",
    "test:watch": "vitest",
    "gallery": "pnpm build && node scripts/generate-gallery.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "check:duplication": "jscpd ./src",
    "check:deadcode": "knip",
    "check:spelling": "cspell \"src/**/*.ts\" \"tests/**/*.ts\"",
    "check:all": "pnpm check:deadcode && pnpm check:spelling && pnpm check:duplication && pnpm check:circular && pnpm check:deps && pnpm check:security && pnpm build && pnpm check:publish && pnpm check:types",
    "check:circular": "madge --circular --extensions ts src/ --json | node -e \"const c=JSON.parse(require('fs').readFileSync('/dev/stdin','utf8')); const n=c.length; if(n>10){console.error('New circular deps found ('+n+' > 10 known type-only cycles)');process.exit(1)}else if(n>0){console.log(n+' known type-only/dynamic cycles (safe)')}else{console.log('No circular dependencies')}\"",
    "check:deps": "depcheck --ignores='@codemirror/language,@lezer/*,husky,lint-staged,tsup'",
    "check:security": "pnpm audit --prod",
    "check:publish": "publint",
    "check:size": "pnpm build && du -sh dist/ && echo '---' && ls -lh dist/*.js dist/*.cjs",
    "check:types": "attw --pack . --ignore-rules no-resolution",
    "postinstall": "node -e \"console.log('\\n💡 Claude Code user? Run: dgmo --install-claude-skill\\n')\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "d3-array": "^3.2.4",
    "d3-cloud": "^1.2.9",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "echarts": "^6.0.0",
    "jsdom": "^29.0.2",
    "lz-string": "^1.5.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@codemirror/language": "^6.12.3",
    "@eslint/js": "^10.0.1",
    "@lezer/generator": "^1.8.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-cloud": "^1.2.9",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.8",
    "@types/jsdom": "^28.0.1",
    "cspell": "^10.0.0",
    "depcheck": "^1.4.7",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "eslint-plugin-security": "^4.0.0",
    "husky": "^9.1.7",
    "jscpd": "^4.0.9",
    "knip": "^6.3.1",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "prettier": "^3.8.2",
    "publint": "^0.3.18",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "@codemirror/language": "^6.12.3",
    "@lezer/common": "^1.5.1",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.8"
  },
  "peerDependenciesMeta": {
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@lezer/common": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    },
    "@lezer/lr": {
      "optional": true
    }
  }
}
